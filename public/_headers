# Cloudflare Pages headers.
# Only the main address (subhameyeclinic.pages.dev) may be indexed; per-deployment and branch copies are hidden from search.
https://:version.subhameyeclinic.pages.dev/*
  X-Robots-Tag: noindex

# Fingerprinted build files never change: cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Clinic photos keep their names when replaced, so cache them for a day only.
/photos/*
  Cache-Control: public, max-age=86400

/*
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
